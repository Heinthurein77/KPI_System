# Production environment — copy to .env on the server (`cp .env.example .env`, then
# `chmod 600 .env`). .env is gitignored and excluded from the Docker image; never commit it.

# ---- Required ---------------------------------------------------------------
ENVIRONMENT=production

# Signs every login session — anyone who learns it can forge a session for any user.
# Generate a fresh one on the server:  openssl rand -hex 32
# The app refuses to start in production with a short or placeholder value.
SECRET_KEY=

# Neon.tech connection string, with sslmode=require. Use the DIRECT host (no "-pooler"
# in the hostname — in the Neon console turn "Connection pooling" off before copying):
# the app keeps its own small connection pool, and startup migrations rely on a
# session-level advisory lock that Neon's PgBouncer pooler does not support.
# Put the droplet in the same region as the Neon project — every query is a round trip.
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxxxx-xxxxxxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Public hostname of the site — Caddy gets and renews its HTTPS certificate for it.
# Hostname only, no "https://". Before starting the stack, its DNS A record must point
# at this server (check: dig +short kpi.example.com) and ports 80/443 must be open.
DOMAIN=kpi.example.com

# ---- Optional tuning (defaults shown) ---------------------------------------
# Gunicorn worker processes. 2 suits 1 vCPU / 2 GB.
# WEB_CONCURRENCY=2

# Per-worker DB pool. Max connections to Neon = WEB_CONCURRENCY x (POOL_SIZE + MAX_OVERFLOW).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# Seconds before a pooled connection is replaced; Neon suspends idle computes after ~5 min.
# DB_POOL_RECYCLE=300
# DB_POOL_TIMEOUT=30

# Session lifetime in minutes (default 24h).
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Only for subdomain-per-tenant routing (acme.example.com). Needs wildcard DNS.
# TENANT_BASE_DOMAIN=example.com

# Not needed here: the React app is served by this same container (same origin), so
# the browser never makes a cross-origin call. Only set it if you host the frontend elsewhere.
# CORS_ORIGINS=https://your-frontend.example.com
