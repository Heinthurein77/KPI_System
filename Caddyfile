# Public HTTPS front door for the KPI app. Caddy obtains and renews the Let's Encrypt
# certificate for {$DOMAIN} by itself, and redirects http:// to https://. That needs:
#   1. a DNS A record for the domain pointing at this server, and
#   2. ports 80 and 443 reachable from the internet (80 is used for the certificate challenge).
# DOMAIN comes from .env via docker-compose.yml — just the hostname, no "https://".
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite content-hashes everything under /assets, so it can be cached indefinitely.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Access log with the real client IP (the app itself only ever sees Caddy's).
	log

	reverse_proxy web:8000 {
		# Overwrite X-Forwarded-For with the real client IP instead of
		# appending to it: a client-supplied value would otherwise let an
		# attacker rotate fake leftmost IPs and dodge the app's per-IP rate
		# limits. The app keys its limiter on the rightmost entry, which is
		# always the one Caddy itself appended.
		header_up X-Forwarded-For {remote_host}
	}
}
