# The root Dockerfile's frontend-build stage needs frontend/ source in the build
# context — only exclude what that stage doesn't need (it runs its own npm ci).
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.local
frontend/.env.test
# M-17a: Playwright session cookies — the e2e setup stores logged-in
# browser state (cookies) under frontend/e2e/.auth/. It must never be
# copied into the Docker build context (or the image).
frontend/e2e/.auth/
